                const parsed = Number.parseFloat(value);
                if (!Number.isNaN(parsed)) {
                  this.bindX = Math.max(0, Math.min(100, parsed)) / 100;
                }
              })
            Text('Y%')
              .fontColor('#DCE5F2')
              .width(48)
            TextInput({ text: (this.bindY * 100).toFixed(0) })
              .type(InputType.Number)
              .layoutWeight(1)
              .height(38)
              .backgroundColor('#0E131C')
              .fontColor('#F4F7FB')
              .onChange((value: string) => {
                const parsed = Number.parseFloat(value);
                if (!Number.isNaN(parsed)) {
                  this.bindY = Math.max(0, Math.min(100, parsed)) / 100;
                }
              })
          }
          .width('100%')
          Row() {
            Text('ä»… FPS æ¨¡å¼ç”Ÿæ•ˆ')
              .fontColor('#DCE5F2')
              .layoutWeight(1)
            Toggle({ type: ToggleType.Switch, isOn: this.bindFpsOnly })
              .selectedColor('#38BDF8')
              .onChange((value: boolean) => {
                this.bindFpsOnly = value;
              })
          }
          .width('100%')
          Button('æ–°å¢žç‚¹æŒ‰ç»‘å®š')
            .width('100%')
            .backgroundColor('#0EA5E9')
            .onClick(() => {
              this.addTapBinding();
            })
          if (this.bindRows.length === 0) {
            Text('æš‚æ— ç»‘å®š')
              .fontSize(13)
              .fontColor('#8994A7')
              .width('100%')
          } else {
            ForEach(this.bindRows, (row: string, index: number) => {
              Row({ space: 8 }) {
                Text(row)
                  .fontSize(13)
                  .fontColor('#DCE5F2')
                  .layoutWeight(1)
                Button('åˆ é™¤')
                  .fontSize(12)
                  .height(32)
                  .backgroundColor('#7F1D1D')
                  .onClick(() => {
                    this.removeBinding(index);
                  })
              }
              .width('100%')
            }, (row: string, index: number) => `${index}:${row}`)
          }
        }
        .padding(14)
        .backgroundColor('#171D28')
        .borderRadius(12)
        .width('100%')

        Column({ space: 10 }) {
          Row() {
            Text('æ ¸å¿ƒè‡ªæ£€')
              .fontColor('#F4F7FB')
              .fontWeight(FontWeight.Medium)
              .layoutWeight(1)
            Button('è¿è¡Œ')
              .fontSize(14)
              .backgroundColor('#0EA5E9')
              .onClick(() => {
                this.runSelfTest();
              })
          }
          .width('100%')
          Text(this.selfTestText)
            .fontSize(13)
            .fontColor('#7DD3FC')
            .width('100%')
        }
        .padding(14)
        .backgroundColor('#171D28')
        .borderRadius(12)
        .width('100%')

        Column({ space: 8 }) {
          Text('é€‚é…çŠ¶æ€')
            .fontColor('#F4F7FB')
            .fontWeight(FontWeight.Medium)
            .width('100%')
          Text(this.statusText)
            .fontColor('#7DD3FC')
            .fontSize(13)
            .width('100%')
          Text('HarmonyOS æ™®é€šåº”ç”¨åªå…è®¸æ— éšœç¢æ‰©å±•æ³¨å…¥å•æŒ‡æ‰‹åŠ¿ï¼›æ— é™æ—¶é•¿é•¿æŒ‰ä¸ŽçœŸæ­£å¤šæŒ‡æ³¨å…¥å—ç³»ç»Ÿæƒé™é™åˆ¶ã€‚')
            .fontSize(12)
            .fontColor('#FBBF24')
            .width('100%')
        }
        .padding(14)
        .backgroundColor('#201B13')
        .borderRadius(12)
        .width('100%')
      }
      .width('100%')
      .padding(18)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#10131A')
  }
}
